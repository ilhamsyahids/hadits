# Production: these are `wrangler secret put` values. Local dev: copy to .dev.vars. Never commit real values.

# Gemini (judge, quote extraction, query embeddings). Without it the engine still runs on FTS + alignment.
GEMINI_API_KEY=
# Bearer token for /admin/* (vector upserts from the embedding job)
ADMIN_TOKEN=
# Sign-in for the admin page (/admin): review queue and submitted texts. Without both, the page stays closed.
ADMIN_USER=
ADMIN_PASSWORD=
# AI Gateway auth token (optional). Without it, Gemini is called directly.
CF_AIG_TOKEN=

# Local dev only (.dev.vars): vectors from `bun run local:embed` live in local D1, at a smaller dimension.
LOCAL_VECTORS=1
EMBED_DIM=768
