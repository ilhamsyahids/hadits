# Copy to .dev.vars for `wrangler dev`. In production these are `wrangler secret put` values. Never commit real values.
GEMINI_API_KEY=
# Bearer token for /admin/* (vector upserts from the embedding job)
ADMIN_TOKEN=
# AI Gateway auth token (AI Gateway → hadits → Settings). Without it, Gemini is called directly.
CF_AIG_TOKEN=
