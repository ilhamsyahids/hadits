---
import { env } from 'cloudflare:workers';
import Base from './Base.astro';
import TermPopover from '../components/TermPopover.vue';
import { localePath, STRINGS, type Locale } from '../i18n/strings';

// Sidebar + inset panel (see docs/design.md). Every nav item points at a page that exists.
interface Props { title: string; description?: string; locale: Locale; path: string; active?: 'check' | 'ask' | 'quran' | 'hadith' | 'lectures' | 'sources' | 'about' | null; noindex?: boolean }
const { title, description, locale, path, active = null, noindex = false } = Astro.props;
const t = STRINGS[locale];
type Item = { id: string; title: string; lang: string; duration: number };
const lectures = (await env.CACHE.get<Item[]>('lectures:index', 'json').catch(() => null)) ?? [];
const other = locale === 'en' ? `/ar${path === '/' ? '/' : path}` : path;
const href = (p: string) => localePath(locale, p);
---
<Base title={title} description={description} locale={locale} path={path} noindex={noindex}>
  <div class="shell">
    <aside class="side" id="side" aria-label={t.nav.menu}>
      <div class="side-head">
        <a class="brand" href={href('/')}><svg class="logo" viewBox="0 0 32 32" width="24" height="24" aria-hidden="true"><rect width="32" height="32" rx="7" /><path d="M11.8 9 Q17.8 11.5 20.4 17.2 Q22.2 22.8 16.6 23 L9.8 23" /></svg><span class="brand-text"><span class="maker">{t.brandMaker}</span><span class="name"><span class:list={["word", { naskh: locale === 'ar' }]}>{t.brandName}</span>{locale === 'en' && <span class="naskh ar-word" lang="ar">دليل</span>}</span></span></a>
        <button class="icon-btn only-desktop" type="button" data-side-toggle aria-controls="side" aria-expanded="true" aria-label={t.nav.hideSidebar} title={t.nav.hideSidebar}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="2.5" stroke="currentColor" stroke-width="1.6" fill="none" /><path d="M9.5 5v14" stroke="currentColor" stroke-width="1.6" /></svg>
        </button>
        <button class="icon-btn only-mobile" type="button" data-close-menu aria-label={t.nav.close}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" /></svg>
        </button>
      </div>
      <nav class="primary">
        <a href={href('/')} aria-current={active === 'check' ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.6" fill="none" /><path d="M16 16l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
          {t.nav.check}
        </a>
        <a href={href('/ask')} aria-current={active === 'ask' ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 5h14v10H10l-5 4z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round" /></svg>
          {t.nav.ask}
        </a>
        <a href={href('/quran')} aria-current={active === 'quran' ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 6c3-1.5 5.5-1.5 8 0v13c-2.5-1.5-5-1.5-8 0zM20 6c-3-1.5-5.5-1.5-8 0v13c2.5-1.5 5-1.5 8 0z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round" /></svg>
          {t.nav.quran}
        </a>
        <a href={href('/hadith')} aria-current={active === 'hadith' ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 4h10l2 2v14H6zM9 9h6M9 13h6M9 17h4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round" stroke-linecap="round" /></svg>
          {t.nav.hadith}
        </a>
        <a href={href('/lectures')} aria-current={active === 'lectures' ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 5h14M5 10h14M5 15h9M5 20h6" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" /></svg>
          {t.nav.lectures}
        </a>
        <a href={href('/sources')} aria-current={active === 'sources' ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 4.5h4v15H5zM10.5 4.5h4v15h-4zM16 5.2l3.4-.9 3.1 14.6-3.4.8z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round" transform="translate(-1.2 0)" /></svg>
          {t.sources.nav}
        </a>
        <a href={href('/about')} aria-current={active === 'about' ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6" fill="none" /><path d="M12 11v5.5M12 7.8v.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          {t.about.nav}
        </a>
      </nav>
      <section class="recent" id="ask-recent" data-base={locale === 'ar' ? '/ar' : ''} data-delete={t.nav.deleteAsk} data-confirm={t.nav.clearAskConfirm} hidden>
        <div class="recent-head"><h2>{t.nav.recentAsk}</h2><button type="button" class="clear-all">{t.nav.clearAsk}</button></div>
        <ul></ul>
      </section>
      {lectures.length > 0 && (
        <section class="recent">
          <h2>{t.nav.recent}</h2>
          <ul>
            {lectures.map((l) => (
              <li><a href={href(`/lectures/${l.id}`)} aria-current={path === `/lectures/${l.id}` ? 'page' : undefined} dir="auto">{l.title}</a></li>
            ))}
          </ul>
        </section>
      )}
    </aside>
    <div class="scrim" data-close-menu hidden></div>

    <main class="panel">
      <header class="panel-top">
        <button class="icon-btn only-desktop show-side" type="button" data-side-toggle aria-controls="side" aria-expanded="false" aria-label={t.nav.showSidebar} title={t.nav.showSidebar}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="2.5" stroke="currentColor" stroke-width="1.6" fill="none" /><path d="M9.5 5v14" stroke="currentColor" stroke-width="1.6" /></svg>
        </button>
        <button class="icon-btn only-mobile" type="button" id="open-menu" aria-controls="side" aria-expanded="false" aria-label={t.nav.menu}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" /></svg>
        </button>
        <a class="brand only-mobile panel-brand" href={href('/')}><svg class="logo" viewBox="0 0 32 32" width="24" height="24" aria-hidden="true"><rect width="32" height="32" rx="7" /><path d="M11.8 9 Q17.8 11.5 20.4 17.2 Q22.2 22.8 16.6 23 L9.8 23" /></svg><span class="brand-text"><span class="maker">{t.brandMaker}</span><span class="name"><span class:list={["word", { naskh: locale === 'ar' }]}>{t.brandName}</span>{locale === 'en' && <span class="naskh ar-word" lang="ar">دليل</span>}</span></span></a>
        <div class="top-actions">
          {!noindex && <a class="text-btn" id="lang-switch" href={other} hreflang={locale === 'en' ? 'ar' : 'en'} lang={locale === 'en' ? 'ar' : 'en'} data-lang={locale === 'en' ? 'ar' : 'en'} aria-label={t.languageLabel}>{t.language}</a>}
          <button class="icon-btn" type="button" id="theme" data-dark={t.theme.dark} data-light={t.theme.light} aria-label={t.theme.light}>
            <svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" fill="none" /><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
            <svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round" /></svg>
          </button>
        </div>
      </header>
      <div class="panel-body">
        <slot />
      </div>
    </main>
  </div>
  <TermPopover client:idle t={t} lang={locale} />
</Base>

<script>
  // Theme toggle (saved per reader) and the mobile drawer (Escape and the scrim close it).
  const root = document.documentElement;
  const theme = document.getElementById('theme')!;
  const label = () => theme.setAttribute('aria-label', root.dataset.theme === 'dark' ? theme.dataset.light! : theme.dataset.dark!);
  label();
  theme.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
    label();
  });

  // The reader's language choice wins over the first-visit redirect (see src/worker.ts).
  document.getElementById('lang-switch')?.addEventListener('click', (e) => {
    document.cookie = `lang=${(e.currentTarget as HTMLElement).dataset.lang}; path=/; max-age=31536000; samesite=lax`;
  });

  // Clipboard API first; the older selection copy where the API is refused (some in-app browsers, no permission).
  const copy = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const field = Object.assign(document.createElement('textarea'), { value: text });
      field.setAttribute('readonly', '');
      field.style.cssText = 'position:fixed;opacity:0';
      document.body.append(field);
      field.select();
      const ok = document.execCommand('copy');
      field.remove();
      return ok;
    }
  };
  // Desktop: the sidebar folds away for more reading room (its button sits beside the name; when folded, one in the
  // top bar brings it back). The choice is remembered in this browser.
  const sideButtons = document.querySelectorAll<HTMLButtonElement>('[data-side-toggle]');
  const syncSide = () => {
    const collapsed = document.documentElement.dataset.sidebar === 'collapsed';
    sideButtons.forEach((b) => b.setAttribute('aria-expanded', String(!collapsed)));
  };
  sideButtons.forEach((b) =>
    b.addEventListener('click', () => {
      const collapsed = document.documentElement.dataset.sidebar !== 'collapsed';
      if (collapsed) document.documentElement.dataset.sidebar = 'collapsed';
      else delete document.documentElement.dataset.sidebar;
      try { localStorage.setItem('sidebar', collapsed ? 'collapsed' : 'open'); } catch { /* not remembered */ }
      syncSide();
      document.querySelector<HTMLButtonElement>(collapsed ? '.show-side' : '.side-head [data-side-toggle]')?.focus();
    }),
  );
  syncSide();

  // Share buttons anywhere on the page (ShareButton.astro, and the same markup in Vue islands).
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-share]');
    if (!btn) return;
    const url = btn.dataset.url || location.href;
    const data = { title: btn.dataset.title || document.title, text: btn.dataset.text || undefined, url };
    if (navigator.share && matchMedia('(pointer: coarse)').matches) {
      try { await navigator.share(data); } catch { /* closed by the reader */ }
      return;
    }
    // Copying refused everywhere: show the link to copy by hand.
    if (!(await copy(url))) return void prompt(btn.dataset.title ?? '', url);
    const label = btn.querySelector('span');
    if (!label) return;
    const before = label.textContent;
    label.textContent = btn.dataset.copied ?? '';
    setTimeout(() => (label.textContent = before), 2000);
  });

  // Saved Ask conversations (localStorage, this browser only).
  type Saved = { id: string; title: string; lectureId: string | null };
  const recent = document.getElementById('ask-recent')!;
  const readIndex = (): Saved[] => { try { return JSON.parse(localStorage.getItem('ask:index') ?? '[]'); } catch { return []; } };
  const current = () => new URLSearchParams(location.search).get('c');
  // Deleting forgets the conversation here and clears its history in the Durable Object that holds it.
  const forget = (ids: string[]) => {
    try {
      for (const id of ids) localStorage.removeItem(`ask:conv:${id}`);
      localStorage.setItem('ask:index', JSON.stringify(readIndex().filter((s) => !ids.includes(s.id))));
    } catch { /* storage blocked: nothing was saved either */ }
    for (const id of ids) {
      const ws = new WebSocket(`${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}/agents/ask-agent/${encodeURIComponent(id)}`);
      ws.onopen = () => { ws.send(JSON.stringify({ type: 'cf_agent_chat_clear' })); setTimeout(() => ws.close(), 500); };
    }
    if (ids.includes(current() ?? '')) location.href = `${recent.dataset.base}/ask`;
    else renderRecent();
  };
  const renderRecent = () => {
    const items = readIndex();
    const ul = recent.querySelector('ul')!;
    ul.replaceChildren(
      ...items.slice(0, 10).map((c) => {
        const li = document.createElement('li');
        const a = li.appendChild(document.createElement('a'));
        const q = new URLSearchParams({ c: c.id, ...(c.lectureId ? { lecture: c.lectureId } : {}) });
        a.href = `${recent.dataset.base}/ask?${q}`;
        a.textContent = c.title;
        a.dir = 'auto';
        if (current() === c.id) a.setAttribute('aria-current', 'page');
        const del = li.appendChild(document.createElement('button'));
        del.type = 'button';
        del.className = 'del';
        del.setAttribute('aria-label', `${recent.dataset.delete}: ${c.title}`);
        del.title = recent.dataset.delete!;
        del.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>';
        del.addEventListener('click', () => forget([c.id]));
        return li;
      }),
    );
    recent.hidden = items.length === 0;
  };
  recent.querySelector('.clear-all')!.addEventListener('click', () => {
    if (confirm(recent.dataset.confirm)) forget(readIndex().map((s) => s.id));
  });
  renderRecent();
  window.addEventListener('ask-history', renderRecent);

  const side = document.getElementById('side')!;
  const open = document.getElementById('open-menu')!;
  const scrim = document.querySelector<HTMLElement>('.scrim')!;
  const setMenu = (on: boolean) => {
    side.classList.toggle('open', on);
    scrim.hidden = !on;
    open.setAttribute('aria-expanded', String(on));
    if (on) side.querySelector<HTMLElement>('a, button')?.focus();
    else open.focus();
  };
  open.addEventListener('click', () => setMenu(true));
  document.querySelectorAll('[data-close-menu]').forEach((el) => el.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && side.classList.contains('open')) setMenu(false); });
</script>

<style>
  .shell { display: grid; grid-template-columns: 272px 1fr; min-height: 100dvh; }
  .side { padding: 20px 14px; display: flex; flex-direction: column; gap: 22px; position: sticky; top: 0; height: 100dvh; overflow-y: auto; }
  .side-head { display: flex; align-items: center; justify-content: space-between; padding: 0 8px; }
  .brand { font-size: 1.45rem; font-weight: 600; letter-spacing: -0.01em; text-decoration: none; display: inline-flex; align-items: center; gap: 10px; }
  /* The name in the scripture face: the product is named for the evidence it shows. */
  .brand .naskh { font-family: var(--scripture); font-weight: 400; }
  /* MajelisNote above, the product name below. */
  .brand-text { display: inline-flex; flex-direction: column; line-height: 1.05; }
  .brand .maker { font-size: 0.72rem; font-weight: 500; color: var(--muted); letter-spacing: 0.01em; }
  .brand .name { display: inline-flex; align-items: baseline; gap: 8px; }
  .brand .ar-word { font-size: 1.15rem; color: var(--muted); margin-inline-start: -2px; }
  .logo rect { fill: var(--invert-bg); }
  .logo path { fill: none; stroke: var(--invert-text); stroke-width: 3.4; stroke-linecap: round; stroke-linejoin: round; }
  .primary { display: flex; flex-direction: column; gap: 2px; }
  .primary a, .recent a {
    display: flex; align-items: center; gap: 12px; padding: 10px 10px; border-radius: var(--r-small);
    text-decoration: none; color: var(--text); min-height: 44px;
  }
  .primary a:hover, .recent a:hover { background: var(--surface-2); }
  .primary a[aria-current='page'], .recent a[aria-current='page'] { background: var(--surface-2); font-weight: 500; }
  .recent h2 { font-size: 0.9rem; font-weight: 500; color: var(--muted); margin: 0 10px 6px; }
  .recent ul { list-style: none; margin: 0; padding: 0; }
  /* Links built by the script above don't carry Astro's scope attribute. */
  .recent-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-inline-end: 4px; }
  .recent-head h2 { margin-bottom: 6px; }
  .clear-all { border: 0; background: none; color: var(--subtle); font: inherit; font-size: 0.82rem; padding: 6px; border-radius: var(--r-small); cursor: pointer; }
  .clear-all:hover { color: var(--text); background: var(--surface-2); }
  #ask-recent :global(li) { position: relative; }
  #ask-recent :global(.del) { position: absolute; inset-inline-end: 4px; top: 50%; transform: translateY(-50%); width: 32px; height: 32px; display: grid; place-items: center; border: 0; border-radius: var(--r-small); background: var(--surface-2); color: var(--muted); cursor: pointer; opacity: 0; }
  #ask-recent :global(li:hover .del), #ask-recent :global(.del:focus-visible) { opacity: 1; }
  #ask-recent :global(.del:hover) { color: var(--text); }
  @media (hover: none) { #ask-recent :global(.del) { opacity: 1; background: none; } #ask-recent :global(a) { padding-inline-end: 40px; } }
  #ask-recent :global(a) { display: block; padding: 10px; border-radius: var(--r-small); text-decoration: none; color: var(--text); min-height: 44px; line-height: 24px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #ask-recent :global(a:hover), #ask-recent :global(a[aria-current='page']) { background: var(--surface-2); }
  .recent a { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; line-height: 24px; }

  .panel { background: var(--panel); margin: 10px; margin-inline-start: 0; border-radius: var(--r-panel); min-height: calc(100dvh - 20px); display: flex; flex-direction: column; min-width: 0; }
  .panel-top { display: flex; align-items: center; gap: 10px; padding: 14px 18px; }
  .top-actions { margin-inline-start: auto; display: flex; align-items: center; gap: 6px; }
  .panel-body { flex: 1; padding: 0 clamp(16px, 4vw, 48px) 48px; min-width: 0; }
  .icon-btn, .text-btn {
    display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px;
    border: 0; background: transparent; border-radius: var(--r-small); cursor: pointer; text-decoration: none; padding: 0 10px; color: var(--text);
  }
  .icon-btn:hover, .text-btn:hover { background: var(--surface-2); }
  :global([data-theme='dark']) .moon, :global([data-theme='light']) .sun { display: none; }
  .only-mobile { display: none; }
  .show-side { display: none; }
  /* Collapsed sidebar (desktop): the panel takes the full width and shows the name itself. */
  @media (min-width: 861px) {
    :global(html[data-sidebar='collapsed']) .shell { grid-template-columns: 0 1fr; }
    :global(html[data-sidebar='collapsed']) .side { visibility: hidden; overflow: hidden; padding: 0; }
    :global(html[data-sidebar='collapsed']) .panel { margin-inline-start: 10px; }
    :global(html[data-sidebar='collapsed']) .panel-brand { display: inline-flex; }
    :global(html[data-sidebar='collapsed']) .show-side { display: inline-flex; }
  }
  .scrim { position: fixed; inset: 0; background: rgb(0 0 0 / 0.45); z-index: 20; }

  @media (max-width: 860px) {
    .shell { grid-template-columns: 1fr; }
    .side {
      position: fixed; inset-block: 0; inset-inline-start: 0; width: min(300px, 86vw); background: var(--frame); z-index: 30;
      transform: translateX(-105%); transition: transform 0.2s ease, visibility 0.2s; height: 100dvh; visibility: hidden;
    }
    :global([dir='rtl']) .side { transform: translateX(105%); }
    .side.open { transform: none; visibility: visible; }
    .only-mobile { display: inline-flex; }
    .only-desktop { display: none; }
    .panel { margin: 0; border-radius: 0; min-height: 100dvh; }
    /* The bar stays at the top while reading on a phone: menu, name, language and theme are always in reach. */
    .panel-top { position: sticky; top: 0; z-index: 15; background: var(--panel); border-bottom: 1px solid var(--line); padding: 8px 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .side { transition: none; } }
</style>
