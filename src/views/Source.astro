---
import { env } from 'cloudflare:workers';
import AppShell from '../layouts/AppShell.astro';
import { family, neighbours, present, reference, resolveKey } from '../corpus/units';
import { SURAHS } from '../corpus/surahs';
import { collection } from '../corpus/collections';
import { chapters } from '../corpus/browse';
import { prophetic } from '../lib/prophetic';
import { localePath, STRINGS, type Locale } from '../i18n/strings';

// Source page (F3): hadits.net/{key}. Every word of scripture here comes from D1.
interface Props { locale: Locale; unitKey: string }
const { locale, unitKey } = Astro.props;
const t = STRINGS[locale];
const row = await resolveKey(env.CORPUS, unitKey).catch(() => null);
if (!row) Astro.response.status = 404;
const u = row ? present(row, { full: true, lang: locale }) : null;
const fam = row && row.kind === 'hadith' ? await family(env.CORPUS, row, 20) : [];
type Narrator = { id: number; role: string; name: string; url: string };
const narrators = (u?.narrators ?? []) as Narrator[];
type Anth = { collection: string; number: string };
const anthologies = (u?.anthologies ?? []) as Anth[];
const href = (p: string) => localePath(locale, p);

// Where this unit sits, for the breadcrumb: collection › chapter (hadith) or surah (Quran).
const coll = row ? collection(row.collection) : undefined;
const chapterList = row?.kind === 'hadith' ? await chapters(env.CORPUS, env.CACHE, row.collection).catch(() => []) : [];
const chapterIndex = row ? chapterList.find((c) => c.en === row.chapter_en && c.ar === row.chapter_ar)?.index : undefined;
const site = u?.url ? new URL(u.url).hostname.replace(/^www\./, '') : null;

// Previous and next: the neighbouring ayah (across surahs), or the neighbouring hadith in the collection's order.
type Step = { key: string; label: string } | null;
let prev: Step = null, next: Step = null;
if (row?.kind === 'quran') {
  const [, s, a] = row.key.split(':').map(Number);
  const ayah = (k: string) => ({ key: `quran:${k}`, label: k });
  if (a > 1) prev = ayah(`${s}:${a - 1}`);
  else if (s > 1) prev = ayah(`${s - 1}:${SURAHS[s - 2][3]}`);
  if (a < SURAHS[s - 1][3]) next = ayah(`${s}:${a + 1}`);
  else if (s < 114) next = ayah(`${s + 1}:1`);
} else if (row) {
  const n = await neighbours(env.CORPUS, row).catch(() => ({ prev: null, next: null }));
  const step = (r: { key: string; collection: string; number: string } | null) =>
    r ? { key: r.key, label: reference({ ...row, ...r }, locale) } : null;
  prev = step(n.prev);
  next = step(n.next);
}
---
<AppShell title={`${u?.reference ?? unitKey} · ${t.brand}`} description={u?.en?.slice(0, 160) ?? t.intro} locale={locale} path={`/${unitKey}`}>
  <article class="page">
    <nav class="crumbs" aria-label={t.sourcePage.crumbs}>
      {row?.kind === 'quran' ? (
        <>
          <a href={href('/quran')}>{t.browse.quran}</a>
          <span aria-hidden="true">›</span>
          <a href={href(`/quran/${row.key.split(':')[1]}#a${row.key.split(':')[2]}`)}>{locale === 'ar' ? row.chapter_ar : row.chapter_en}</a>
        </>
      ) : row && coll ? (
        <>
          <a href={href('/hadith')}>{t.browse.hadith}</a>
          <span aria-hidden="true">›</span>
          <a href={href(`/hadith/${row.collection}`)}>{locale === 'ar' ? coll.ar : coll.en}</a>
          {chapterIndex && (
            <>
              <span aria-hidden="true">›</span>
              <a href={href(`/hadith/${row.collection}/${chapterIndex}`)} dir="auto">{(locale === 'ar' ? row.chapter_ar ?? row.chapter_en : row.chapter_en ?? row.chapter_ar)}</a>
            </>
          )}
        </>
      ) : (
        <a href={href('/')}>{t.sourcePage.back}</a>
      )}
    </nav>
    {!u ? <p class="muted">{t.sourcePage.notFound}</p> : (
      <>
        <header>
          <h1>{u.reference}</h1>
          {u.section && (locale === 'ar' ? u.section.ar : u.section.en) && (
            <p class="muted" dir="auto">{locale === 'ar' ? u.section.ar : u.section.en}</p>
          )}
          {u.parallel_of && <p class="muted">{t.sourcePage.parallel} <a href={href(`/${u.parallel_of}`)}>{u.parallel_of}</a></p>}
        </header>

        {u.ar.isnad && (
          <details class="isnad">
            <summary>{t.sourcePage.showIsnad}</summary>
            <p class="scripture small" lang="ar">{u.ar.isnad}</p>
          </details>
        )}
        <p class={`scripture main${u.kind === 'quran' ? ' quran' : ''}`} lang="ar">
          {prophetic(u.ar.matn, 'ar').map((p) => (p.prophetic ? <span class="prophetic">{p.text}</span> : p.text))}
        </p>
        {locale === 'en' && u.en && (
          <section>
            <h2>{t.sourcePage.translation}</h2>
            {u.en_isnad && (
              <details class="isnad" open>
                <summary>{t.sourcePage.chain}</summary>
                <ol class="chain-en">{u.en_isnad.split(/\s*>\s*/).map((n) => <li>{n}</li>)}</ol>
              </details>
            )}
            <p class="translation">{prophetic(u.en, 'en').map((p) => (p.prophetic ? <span class="prophetic">{p.text}</span> : p.text))}</p>
          </section>
        )}

        {u.kind === 'hadith' && (
          <section>
            <h2>{t.gradedBy}</h2>
            {u.grades.length ? (
              <div class="grades">
                <label class="toggle"><input type="checkbox" class="show-sources" /> {t.sourcePage.showGradeSources}</label>
                <table>
                  <tbody>
                    {u.grades.map((g) => (
                      <tr>
                        <th scope="row">{g.grader}</th>
                        <td>
                          {g.grade}
                          {g.via && <span class="via">{t.sourcePage.gradeVia.split('{via}')[0]}<a href={href(`/${g.via}`)}>{g.via}</a>{t.sourcePage.gradeVia.split('{via}')[1]}</span>}
                          {g.others?.map((o) => (
                            <span class="other">{o.via && o.via !== g.via
                              ? t.sourcePage.otherGradeVia.replace('{via}', o.via).replace('{grade}', o.grade)
                              : t.sourcePage.otherGrade.replace('{grade}', o.grade).replace('{sources}', o.sources.join(', '))}</span>
                          ))}
                        </td>
                        <td class="src">{g.sources.join(', ')}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : <p class="muted">{t.noGrade}</p>}
          </section>
        )}

        {fam.length > 0 && (
          <section>
            <h2>{t.variants}</h2>
            <ul class="family">
              {fam.map((f) => (
                <li><a href={href(`/${f.key}`)}>{f.collection_name} {f.number}</a><span class="scripture tiny" lang="ar">{prophetic(f.ar, 'ar').map((p) => (p.prophetic ? <span class="prophetic">{p.text}</span> : p.text))}</span></li>
              ))}
            </ul>
          </section>
        )}

        {narrators.length > 0 && (
          <section>
            <h2>{t.sourcePage.narrators}</h2>
            <ol class="chain" lang="ar" dir="rtl">
              {narrators.map((n) => <li><a href={n.url} target="_blank" rel="noopener">{n.name}</a></li>)}
            </ol>
          </section>
        )}

        {anthologies.length > 0 && (
          <section>
            <h2>{t.sourcePage.anthologies}</h2>
            <p class="links">{anthologies.map((a) => { const c = collection(a.collection); return <a href={href(`/${a.collection}:${a.number}`)}>{(locale === 'ar' ? c?.ar : c?.en) ?? a.collection} {a.number}</a>; })}</p>
          </section>
        )}

        <nav class="foot" aria-label={t.sourcePage.around}>
          {prev ? <a href={href(`/${prev.key}`)} rel="prev" class="step"><small>{t.sourcePage.prev}</small>{prev.label}</a> : <span />}
          {u.url && <a href={u.url} target="_blank" rel="noopener" class="out">{t.sourcePage.viewOn.replace('{site}', site ?? '')}</a>}
          {next ? <a href={href(`/${next.key}`)} rel="next" class="step next"><small>{t.sourcePage.next}</small>{next.label}</a> : <span />}
        </nav>
      </>
    )}
  </article>
</AppShell>

<style>
  .page { max-width: 820px; margin: 0 auto; padding-top: 16px; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: baseline; color: var(--muted); padding: 10px 0; }
  .crumbs a { color: var(--muted); text-underline-offset: 3px; }
  /* Grade sources are hidden until the reader asks for them (CSS only, no script). */
  .grades .src { display: none; color: var(--muted); }
  .grades:has(.show-sources:checked) .src { display: table-cell; }
  .toggle { display: inline-flex; gap: 8px; align-items: center; color: var(--muted); font-size: 0.9rem; min-height: 36px; cursor: pointer; }
  .other { display: block; color: var(--warn); font-size: 0.88rem; }
  .via { display: block; color: var(--muted); font-size: 0.85rem; }
  h1 { font-size: 1.8rem; font-weight: 500; margin: 8px 0 4px; letter-spacing: -0.01em; }
  h2 { font-size: 0.9rem; font-weight: 500; color: var(--muted); margin: 32px 0 10px; }
  .muted { color: var(--muted); margin: 0; }
  .scripture.main { font-size: clamp(1.5rem, 2.6vw, 1.9rem); line-height: 2.15; margin: 24px 0 8px; }
  .scripture.small { font-size: 1.15rem; color: var(--muted); }
  .scripture.tiny { font-size: 1.05rem; line-height: 1.9; color: var(--muted); display: block; }
  .isnad { margin-top: 18px; }
  .isnad summary { cursor: pointer; color: var(--muted); padding: 8px 0; min-height: 40px; }
  .translation { margin: 0; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: start; padding: 10px 12px 10px 0; border-bottom: 1px solid var(--line); vertical-align: top; font-weight: 400; }
  th { font-weight: 500; }
  .warn { color: var(--warn); }
  .family { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }
  /* English chain, in transmission order (the compiler's teacher first, the Companion last). */
  .chain-en { display: flex; flex-wrap: wrap; gap: 4px 4px; padding: 0; list-style: none; margin: 0 0 12px; color: var(--muted); }
  .chain-en li:not(:last-child)::after { content: '›'; margin-inline-start: 6px; color: var(--subtle); }
  .chain { display: flex; flex-wrap: wrap; gap: 6px 4px; padding: 0; list-style: none; margin: 0; }
  .chain li:not(:last-child)::after { content: '←'; color: var(--subtle); margin-inline-start: 6px; }
  .links { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 0; }
  .foot { display: flex; justify-content: space-between; gap: 12px; margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); flex-wrap: wrap; }
  .foot { align-items: center; }
  .foot a { color: var(--muted); text-underline-offset: 3px; padding: 10px 0; }
  .foot .step { display: flex; flex-direction: column; color: var(--text); text-decoration: none; min-width: 0; }
  .foot .step small { color: var(--muted); font-size: 0.82rem; }
  .foot .step:hover { text-decoration: underline; }
  .foot .next { text-align: end; }
  @media (max-width: 560px) { th, td { display: block; padding: 4px 0; border: 0; } tr { display: block; padding: 8px 0; border-bottom: 1px solid var(--line); } }
</style>
