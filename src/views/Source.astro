---
import { env } from 'cloudflare:workers';
import AppShell from '../layouts/AppShell.astro';
import { family, present, resolveKey } from '../corpus/units';
import { SURAHS } from '../corpus/surahs';
import { collection } from '../corpus/collections';
import { localePath, STRINGS, type Locale } from '../i18n/strings';

// Source page (F3): hadits.net/{key}. Every word of scripture here comes from D1.
interface Props { locale: Locale; unitKey: string }
const { locale, unitKey } = Astro.props;
const t = STRINGS[locale];
const row = await resolveKey(env.CORPUS, unitKey).catch(() => null);
if (!row) Astro.response.status = 404;
const u = row ? present(row, { full: true, lang: locale }) : null;
const fam = row && row.kind === 'hadith' ? await family(env.CORPUS, row, 20) : [];
type Narrator = { id: number; role: string; name: string; url: string };
const narrators = (u?.narrators ?? []) as Narrator[];
type Anth = { collection: string; number: string };
const anthologies = (u?.anthologies ?? []) as Anth[];
const href = (p: string) => localePath(locale, p);

let prev: string | null = null, next: string | null = null;
if (row?.kind === 'quran') {
  const [, s, a] = row.key.split(':').map(Number);
  if (a > 1) prev = `quran:${s}:${a - 1}`;
  else if (s > 1) prev = `quran:${s - 1}:${SURAHS[s - 2][3]}`;
  if (a < SURAHS[s - 1][3]) next = `quran:${s}:${a + 1}`;
  else if (s < 114) next = `quran:${s + 1}:1`;
}
---
<AppShell title={`${u?.reference ?? unitKey} · ${t.brand}`} description={u?.en?.slice(0, 160) ?? t.intro} locale={locale} path={`/${unitKey}`}>
  <article class="page">
    <a class="back" href={href('/')}>{t.sourcePage.back}</a>
    {!u ? <p class="muted">{t.sourcePage.notFound}</p> : (
      <>
        <header>
          <h1>{u.reference}</h1>
          {(u.chapter || u.section) && (
            <p class="muted" dir="auto">{[locale === 'ar' ? u.chapter?.ar : u.chapter?.en, locale === 'ar' ? u.section?.ar : u.section?.en].filter(Boolean).join(' › ')}</p>
          )}
          {u.parallel_of && <p class="muted">{t.sourcePage.parallel} <a href={href(`/${u.parallel_of}`)}>{u.parallel_of}</a></p>}
        </header>

        {u.ar.isnad && (
          <details class="isnad">
            <summary>{t.sourcePage.showIsnad}</summary>
            <p class="scripture small" lang="ar">{u.ar.isnad}</p>
          </details>
        )}
        <p class="scripture main" lang="ar">{u.ar.matn}</p>
        {locale === 'en' && u.en && (
          <section>
            <h2>{t.sourcePage.translation}</h2>
            <p class="translation">{u.en}</p>
          </section>
        )}

        {u.kind === 'hadith' && (
          <section>
            <h2>{t.gradedBy}</h2>
            {u.grades.length ? (
              <table>
                <tbody>
                  {u.grades.map((g) => (
                    <tr>
                      <th scope="row">{g.grader}</th>
                      <td>{g.grade}{g.conflict && <span class="warn"> ⚠</span>}</td>
                      <td class="muted">{g.sources.join(', ')}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : <p class="muted">{t.noGrade}</p>}
          </section>
        )}

        {fam.length > 0 && (
          <section>
            <h2>{t.variants}</h2>
            <ul class="family">
              {fam.map((f) => (
                <li><a href={href(`/${f.key}`)}>{f.collection_name} {f.number}</a><span class="scripture tiny" lang="ar">{f.ar}</span></li>
              ))}
            </ul>
          </section>
        )}

        {narrators.length > 0 && (
          <section>
            <h2>{t.sourcePage.narrators}</h2>
            <ol class="chain" lang="ar" dir="rtl">
              {narrators.map((n) => <li><a href={n.url} target="_blank" rel="noopener">{n.name}</a></li>)}
            </ol>
          </section>
        )}

        {anthologies.length > 0 && (
          <section>
            <h2>{t.sourcePage.anthologies}</h2>
            <p class="links">{anthologies.map((a) => { const c = collection(a.collection); return <a href={href(`/${a.collection}:${a.number}`)}>{(locale === 'ar' ? c?.ar : c?.en) ?? a.collection} {a.number}</a>; })}</p>
          </section>
        )}

        <nav class="foot">
          {prev && <a href={href(`/${prev}`)} rel="prev">{prev.replace('quran:', '')}</a>}
          <a href={u.url} target="_blank" rel="noopener">{t.external}</a>
          {next && <a href={href(`/${next}`)} rel="next">{next.replace('quran:', '')}</a>}
        </nav>
      </>
    )}
  </article>
</AppShell>

<style>
  .page { max-width: 820px; margin: 0 auto; padding-top: 16px; }
  .back { color: var(--muted); text-underline-offset: 3px; display: inline-block; padding: 10px 0; }
  h1 { font-size: 1.8rem; font-weight: 500; margin: 8px 0 4px; letter-spacing: -0.01em; }
  h2 { font-size: 0.9rem; font-weight: 500; color: var(--muted); margin: 32px 0 10px; }
  .muted { color: var(--muted); margin: 0; }
  .scripture.main { font-size: clamp(1.5rem, 2.6vw, 1.9rem); line-height: 2.15; margin: 24px 0 8px; }
  .scripture.small { font-size: 1.15rem; color: var(--muted); }
  .scripture.tiny { font-size: 1.05rem; line-height: 1.9; color: var(--muted); display: block; }
  .isnad { margin-top: 18px; }
  .isnad summary { cursor: pointer; color: var(--muted); padding: 8px 0; min-height: 40px; }
  .translation { margin: 0; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: start; padding: 10px 12px 10px 0; border-bottom: 1px solid var(--line); vertical-align: top; font-weight: 400; }
  th { font-weight: 500; }
  .warn { color: var(--warn); }
  .family { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .chain { display: flex; flex-wrap: wrap; gap: 6px 4px; padding: 0; list-style: none; margin: 0; }
  .chain li:not(:last-child)::after { content: '←'; color: var(--subtle); margin-inline-start: 6px; }
  .links { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 0; }
  .foot { display: flex; justify-content: space-between; gap: 12px; margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); flex-wrap: wrap; }
  .foot a { color: var(--muted); text-underline-offset: 3px; padding: 10px 0; }
  @media (max-width: 560px) { th, td { display: block; padding: 4px 0; border: 0; } tr { display: block; padding: 8px 0; border-bottom: 1px solid var(--line); } }
</style>
