---
import { env } from 'cloudflare:workers';
import AskChat from '../components/AskChat.vue';
import DocOwner from '../components/DocOwner.vue';
import LectureReport from '../components/LectureReport.vue';
import ShareButton from '../components/ShareButton.astro';
import AppShell from '../layouts/AppShell.astro';
import { timingOf, type Doc } from '../lectures/doc';
import { cachedReport } from '../lectures/report';
import { localePath, STRINGS, type Locale } from '../i18n/strings';

interface Props { locale: Locale; id: string }
const { locale, id } = Astro.props;
const t = STRINGS[locale];
const lecture = await env.CACHE.get<Doc>(`lecture:${id}`, 'json').catch(() => null);
if (!lecture) Astro.response.status = 404;
const timing = lecture ? timingOf(lecture) : 'position';
// The full text goes to the report as plain data: it is shown exactly as it was checked.
const segments = lecture?.segments.map((s) => ({ text: s.text, section: s.section ?? null, start: s.start })) ?? [];
const src = lecture?.source;
// A cached report is rendered with the page; only a text never checked in this language is checked on load.
const initial = lecture ? await cachedReport(env, id, locale) : null;
---
<AppShell title={`${lecture?.title ?? t.lectures.heading} · ${t.brand}`} description={t.lectures.intro} locale={locale} path={`/lectures/${id}`} active="lectures">
  <section class="page">
    {lecture ? (
      <>
        <h1 dir="auto" lang={lecture.lang}>{lecture.title}</h1>
        <p class="meta">
          {t.lectures.kindName[lecture.kind ?? 'lecture']} · {t.lectures.langName[lecture.lang] ?? lecture.lang} ·{' '}
          {timing === 'audio' ? `${Math.round(lecture.duration / 60)} ${t.lectures.minutes}` : `${segments.length} ${t.lectures.paragraphs}`}
        </p>
        {lecture.submitted && (
          <p class="meta source"><DocOwner client:load id={id} expires={lecture.submitted.expires} t={t} lang={locale} /></p>
        )}
        {src && (
          <p class="meta source">
            {t.lectures.source}:{' '}
            {src.url ? <a href={src.url} target="_blank" rel="noopener" dir="auto">{src.name}</a> : <span dir="auto">{src.name}</span>}
            {src.license && <> · {src.license_url ? <a href={src.license_url} target="_blank" rel="noopener">{src.license}</a> : src.license}</>}
            {src.note && <> · <span dir="auto">{src.note}</span></>}
          </p>
        )}
        <p class="actions">
          <a class="ask-link" id="open-ask" aria-controls="ask-panel" aria-expanded="false" href={localePath(locale, `/ask?lecture=${id}`)}>{lecture.kind === 'article' ? t.ask.openArticle : lecture.kind === 'text' ? t.ask.openText : t.ask.open}</a>
          <ShareButton locale={locale} title={`${lecture.title} · ${t.share.report}`} />
        </p>
        <LectureReport client:load id={id} initial={initial} duration={lecture.duration} timing={timing} segments={segments} textLang={lecture.lang} t={t} lang={locale} />
      </>
    ) : (
      <p class="meta">{t.lectures.empty}</p>
    )}
  </section>
  {lecture && (
    <aside class="ask-panel" id="ask-panel" aria-label={lecture.kind === 'article' ? t.ask.openArticle : t.ask.open}>
      <AskChat client:only="vue" t={t} lang={locale} lectureId={id} lectureTitle={lecture.title} lectureKind={lecture.kind ?? 'lecture'} embedded />
    </aside>
  )}
</AppShell>

<script>
  // Ask beside the report: the link opens the panel instead of another page (it still works without script).
  const panel = document.getElementById('ask-panel');
  const open = document.getElementById('open-ask');
  const setOpen = (on: boolean) => {
    if (on) document.documentElement.dataset.askOpen = '';
    else delete document.documentElement.dataset.askOpen;
    open?.setAttribute('aria-expanded', String(on));
    if (on) setTimeout(() => panel?.querySelector<HTMLTextAreaElement>('textarea')?.focus(), 50);
    else open?.focus({ preventScroll: true });
  };
  open?.addEventListener('click', (e) => {
    e.preventDefault();
    setOpen(!('askOpen' in document.documentElement.dataset));
  });
  window.addEventListener('ask-panel', (e) => setOpen((e as CustomEvent<boolean>).detail));
  // "Ask about this" on a selection or a term opens the panel (AskChat fills its box from the same event).
  window.addEventListener('ask-prefill', () => setOpen(true));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && 'askOpen' in document.documentElement.dataset && setOpen(false));
  if (location.hash === '#ask') setOpen(true);
</script>

<style>
  .page { max-width: 920px; margin: 0 auto; padding-top: 24px; }
  h1 { font-size: 1.8rem; font-weight: 500; margin: 0 0 6px; letter-spacing: -0.01em; }
  .meta { color: var(--muted); margin: 0 0 12px; }
  .source { margin-top: -6px; font-size: 0.92rem; }
  .source a { color: var(--muted); text-underline-offset: 3px; }
  .ask-link { display: inline-flex; align-items: center; min-height: 40px; padding: 0 14px; border: 1px solid var(--line); border-radius: 20px; text-decoration: none; }
  .ask-link:hover { background: var(--surface-2); }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .ask-link[aria-expanded='true'] { background: var(--invert-bg); color: var(--invert-text); border-color: var(--invert-bg); }
  /* The Ask panel: docked on the right beside the report on wide screens, over the page on smaller ones. */
  .ask-panel { display: none; position: fixed; z-index: 25; inset-block: 10px; inset-inline-end: 10px; width: 440px; background: var(--panel); border: 1px solid var(--line); border-radius: var(--r-panel); flex-direction: column; overflow: hidden; }
  :global(html[data-ask-open]) .ask-panel { display: flex; }
  @media (min-width: 1100px) { :global(html[data-ask-open]) .page { margin-inline: 0 460px; } }
  @media (max-width: 1099px) { .ask-panel { inset: 0; width: auto; border-radius: 0; border: 0; } }
</style>
