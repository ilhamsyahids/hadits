---
import { env } from 'cloudflare:workers';
import AppShell from '../layouts/AppShell.astro';
import { chapterHadith, chapters } from '../corpus/browse';
import { collection } from '../corpus/collections';
import { localePath, STRINGS, type Locale } from '../i18n/strings';
import { prophetic } from '../lib/prophetic';

interface Props { locale: Locale; id: string; index: number }
const { locale, id, index } = Astro.props;
const t = STRINGS[locale];
const meta = collection(id);
const list = meta ? await chapters(env.CORPUS, env.CACHE, id).catch(() => []) : [];
const ch = list.find((c) => c.index === index);
const items = ch ? await chapterHadith(env.CORPUS, id, ch) : [];
if (!ch) Astro.response.status = 404;
const name = ch ? ((locale === 'ar' ? ch.ar ?? ch.en : ch.en ?? ch.ar) ?? '') : '';
const href = (p: string) => localePath(locale, p);
const tone = (g: string | null) => (['daif', 'mawdu', 'disputed'].includes(g ?? '') ? 'warn' : ['sahihayn', 'sahih', 'hasan', 'hasan_sahih', 'hasan_or_sahih', 'accepted'].includes(g ?? '') ? 'ok' : 'none');
---
<AppShell title={`${name} · ${meta ? (locale === 'ar' ? meta.ar : meta.en) : ''} · ${t.brand}`} description={t.browse.hadithIntro} locale={locale} path={`/hadith/${id}/${index}`} active="hadith">
  <section class="page">
    <a class="back" href={href(`/hadith/${id}`)}>{meta ? (locale === 'ar' ? meta.ar : meta.en) : t.browse.allCollections}</a>
    {!ch ? <p class="muted">{t.browse.empty}</p> : (
      <>
        <h1 dir="auto">{index}. {name}</h1>
        <ol class="items">
          {items.map((h) => (
            <li>
              <p class="head">
                <a href={href(`/${h.key}`)}>{meta ? (locale === 'ar' ? meta.ar : meta.en) : id} {h.number}</a>
                <span class={`grade ${tone(h.grade_status)}`}><span class="mark" aria-hidden="true"></span>{t.gradeStatus[h.grade_status ?? 'ungraded'] ?? h.grade_status}</span>
              </p>
              <p class="scripture clamp" lang="ar">{prophetic(h.ar_matn, 'ar', h.said).map((p) => (p.prophetic ? <span class="prophetic">{p.text}</span> : p.text))}</p>
              {locale === 'en' && h.en_text && <p class="en clamp2">{prophetic(h.en_text, 'en').map((p) => (p.prophetic ? <span class="prophetic">{p.text}</span> : p.text))}</p>}
            </li>
          ))}
        </ol>
        {items.length >= 500 && <p class="muted">{t.browse.capped}</p>}
        <nav class="foot">
          {index > 1 ? <a href={href(`/hadith/${id}/${index - 1}`)} rel="prev">{t.browse.prev}</a> : <span></span>}
          {index < list.length && <a href={href(`/hadith/${id}/${index + 1}`)} rel="next">{t.browse.next}</a>}
        </nav>
      </>
    )}
  </section>
</AppShell>

<style>
  .page { max-width: 820px; margin: 0 auto; padding-top: 16px; }
  .back { color: var(--muted); text-underline-offset: 3px; display: inline-block; padding: 10px 0; }
  h1 { font-size: 1.6rem; font-weight: 500; margin: 8px 0 16px; }
  .muted { color: var(--muted); }
  .items { list-style: none; padding: 0; margin: 0; }
  .items li { padding: 16px 0; border-bottom: 1px solid var(--line); }
  .head { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin: 0 0 6px; }
  .head a { font-weight: 500; text-underline-offset: 3px; }
  .grade { display: inline-flex; align-items: center; gap: 6px; font-size: 0.88rem; color: var(--muted); }
    .scripture { font-size: 1.3rem; margin: 0; }
  .clamp { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .en { color: var(--muted); margin: 6px 0 0; font-size: 0.95rem; }
  .clamp2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .foot { display: flex; justify-content: space-between; gap: 12px; margin: 28px 0; }
  .foot a { color: var(--muted); text-underline-offset: 3px; padding: 10px 0; }
</style>
