---
import { env } from 'cloudflare:workers';
import AppShell from '../layouts/AppShell.astro';
import { chapters } from '../corpus/browse';
import { collection } from '../corpus/collections';
import { localePath, STRINGS, type Locale } from '../i18n/strings';

interface Props { locale: Locale; id: string }
const { locale, id } = Astro.props;
const t = STRINGS[locale];
const meta = collection(id);
const list = meta && meta.id !== 'quran' ? await chapters(env.CORPUS, env.CACHE, id).catch(() => []) : [];
if (!meta || !list.length) Astro.response.status = 404;
const title = meta ? (locale === 'ar' ? meta.ar : meta.en) : t.browse.hadith;
---
<AppShell title={`${title} · ${t.brand}`} description={t.browse.hadithIntro} locale={locale} path={`/hadith/${id}`} active="hadith">
  <section class="page">
    <a class="back" href={localePath(locale, '/hadith')}>{t.browse.allCollections}</a>
    <h1>{title}</h1>
    {locale === 'en' && meta && <p class="ar-title" lang="ar">{meta.ar}</p>}
    {!list.length ? <p class="muted">{t.browse.empty}</p> : (
      <>
        <h2>{t.browse.chapters}</h2>
        <ol class="chapters">
          {list.map((c) => (
            <li>
              <a href={localePath(locale, `/hadith/${id}/${c.index}`)}>
                <span class="n">{c.index}</span>
                <span class="name" dir="auto">{(locale === 'ar' ? c.ar ?? c.en : c.en ?? c.ar) ?? '·'}</span>
                <span class="count">{c.count}</span>
              </a>
            </li>
          ))}
        </ol>
      </>
    )}
  </section>
</AppShell>

<style>
  .page { max-width: 820px; margin: 0 auto; padding-top: 16px; }
  .back { color: var(--muted); text-underline-offset: 3px; display: inline-block; padding: 10px 0; }
  h1 { font-size: 1.8rem; font-weight: 500; margin: 8px 0 0; }
  .ar-title { font-family: var(--scripture); font-size: 1.5rem; margin: 0; }
  h2 { font-size: 0.95rem; font-weight: 500; color: var(--muted); margin: 24px 0 8px; }
  .muted { color: var(--muted); }
  .chapters { list-style: none; padding: 0; margin: 0; }
  .chapters a { display: grid; grid-template-columns: 2.6em 1fr auto; gap: 10px; padding: 12px 6px; border-bottom: 1px solid var(--line); text-decoration: none; min-height: 44px; align-items: baseline; }
  .chapters a:hover { background: var(--surface-2); }
  .n, .count { color: var(--muted); font-variant-numeric: tabular-nums; font-size: 0.9rem; }
</style>
