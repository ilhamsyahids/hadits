---
import CheckQuote from './CheckQuote.vue';
import Base from '../layouts/Base.astro';
import { STRINGS, type Locale } from '../i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = STRINGS[locale];
const other = locale === 'en' ? '/ar/' : '/';
---
<Base title={t.title} description={t.intro} locale={locale}>
  <main>
    <header class="top">
      <strong class="brand">Dalil</strong>
      <a href={other} hreflang={locale === 'en' ? 'ar' : 'en'}>{t.language}</a>
    </header>
    <h1>{t.tagline}</h1>
    <p class="intro">{t.intro}</p>
    <CheckQuote client:load t={t} lang={locale} />
  </main>
</Base>

<style>
  .top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; }
  .brand { font-size: 1.1rem; letter-spacing: 0.02em; }
  h1 { font-size: clamp(1.5rem, 4vw, 2rem); line-height: 1.25; margin: 0 0 12px; }
  .intro { color: var(--muted); margin: 0 0 24px; }
</style>
