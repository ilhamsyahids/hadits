{
  "name": "hadits",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "deploy": "astro build && wrangler deploy",
    "types": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "eval": "bun eval/run.ts",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "golden": "python3 eval/build_golden.py",
    "local:setup": "wrangler d1 execute hadits-corpus --local --file sample/corpus.sql && wrangler kv key put --local --binding CACHE df:v1 --path sample/df.json",
    "local:embed": "bun tools/local_embed.ts",
    "sample": "python3 tools/build_sample.py"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/vue": "^7",
    "astro": "^7.3.5",
    "hono": "^4.13.13",
    "vue": "^3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "packageManager": "bun@1.4.0"
}
